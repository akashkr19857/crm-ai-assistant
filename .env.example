# Copy to .env to override defaults (all optional). Everything runs locally; no API keys needed.
CRM_OLLAMA_URL=http://localhost:11434
CRM_LLM_MODEL=qwen2.5:7b
CRM_EMBED_MODEL=nomic-embed-text
CRM_RERANKER_MODEL=BAAI/bge-reranker-base
# number/date grounding check with one regeneration and a data-only fallback
CRM_VALIDATE_ANSWERS=true
# previous messages given to the router for multi-turn context
CRM_HISTORY_TURNS=6
# seed for the deterministic demo CRM data
CRM_CRM_SEED=7
CRM_CORS_ORIGINS=http://localhost:3300,http://127.0.0.1:3300
# Frontend (frontend/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:8300
